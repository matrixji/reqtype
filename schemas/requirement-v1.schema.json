{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqtype.local/schemas/requirement-v1.schema.json",
  "title": "ReqType requirement metadata v1 (inherits module version)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "key": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "type",
          "target"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": true
}
