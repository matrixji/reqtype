{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqtype.local/schemas/project-v2.schema.json",
  "title": "ReqType project configuration v2",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "linkTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "enum",
              "array"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "items": {
            "enum": [
              "string",
              "number"
            ]
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "enum"
                }
              }
            },
            "then": {
              "required": [
                "values"
              ]
            }
          }
        ]
      }
    },
    "requirement": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}_.-]{0,31}$"
        },
        "padding": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "defaultType": {
          "type": "string"
        },
        "defaultPriority": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "properties": {
        "initial": {
          "type": "string"
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "general": {
      "type": "object",
      "properties": {
        "defaultView": {
          "enum": [
            "document",
            "table"
          ]
        },
        "spellcheck": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "exports": {
      "type": "object",
      "properties": {
        "defaultFormat": {
          "enum": [
            "json",
            "markdown"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "prettyJson": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "typeAttributes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    }
  },
  "required": [
    "version",
    "name"
  ],
  "additionalProperties": true
}
