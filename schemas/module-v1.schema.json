{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqtype.local/schemas/module-v1.schema.json",
  "title": "ReqType Markdown front matter v1",
  "type": "object",
  "properties": {
    "reqtype": {
      "const": 1
    },
    "module": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "reqtype",
    "module"
  ],
  "additionalProperties": true
}
