{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqtype.local/schemas/ai-v1.schema.json",
  "title": "ReqType local AI settings v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "payload"
  ],
  "properties": {
    "format": {
      "const": "reqtype.ai"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "enabled",
        "baseUrl",
        "model",
        "protocol"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "protocol": {
          "const": "chat-completions"
        },
        "encryptedKey": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
