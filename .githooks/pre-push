#!/bin/sh
# Local guard for the PR-only main workflow; GitHub Pro is needed for server enforcement.
while read -r local_ref local_oid remote_ref remote_oid
do
  if [ "$remote_ref" = refs/heads/main ]; then
    printf '%s\n' 'ReqType: main 通过 GitHub Pull Request 合并；请推送工作分支并创建 PR。' >&2
    exit 1
  fi
done
exit 0
